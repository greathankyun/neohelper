# Neon 連線字串（在 Neon dashboard 複製，注意要用 pooled connection）
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# 隨機字串即可，用來簽發登入 token，正式環境請換成長一點的亂數
JWT_SECRET="change-me-to-a-long-random-string"

# 全科共用的登入密碼（不是帳號系統，只是簡單的存取門檻）
SHARED_PASSWORD="change-me"

PORT=8787

# 正式環境請改成你的 Cloudflare Pages 網域，例如 https://nb-clinical.pages.dev
CORS_ORIGIN="*"
